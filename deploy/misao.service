# misao デーモンの systemd ユーザー unit。インストール手順は deploy/README.md を参照。
[Unit]
Description=misao daemon (headless pane server)

[Service]
Type=simple
ExecStart=%h/.local/bin/misao serve
# 停止時は、デーモンが自分で pane を閉じる (systemd と終了処理を取り合わない)。
# クラッシュ時に残ったプロセスには systemd が触れない
KillMode=process
Restart=on-failure
RestartSec=1

[Install]
WantedBy=default.target
