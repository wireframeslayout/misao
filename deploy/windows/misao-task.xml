<?xml version="1.0" encoding="UTF-16"?>
<!--
  misao デーモンの Windows タスクスケジューラのタスク。インストール手順は deploy/README.md を参照。
  __USER__ / __MISAO__ / __LOG__ は install-task.ps1 が置き換える。
    __USER__   起動するユーザー (DOMAIN\name)
    __MISAO__  misao.exe の絶対パス
    __LOG__    デーモンのログの出力先
  - ログオン時に、そのユーザーの権限 (昇格なし) で起動する。サービスにしない理由は docs/windows.md を参照。
  - conhost.exe の headless モードで窓を出さずに起動し、cmd.exe でログを追記する。
  - 失敗 (非ゼロ終了) のときだけ 1 分後に再起動する。`misao stop` の正常終了 (0) では再起動しない
    (systemd の Restart=on-failure と同じ。間隔の下限は 1 分)。
-->
<Task version="1.4" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>misao daemon (headless pane server)</Description>
  </RegistrationInfo>
  <Triggers>
    <LogonTrigger>
      <Enabled>true</Enabled>
      <UserId>__USER__</UserId>
    </LogonTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <UserId>__USER__</UserId>
      <LogonType>InteractiveToken</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <AllowHardTerminate>true</AllowHardTerminate>
    <StartWhenAvailable>true</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>false</RunOnlyIfNetworkAvailable>
    <IdleSettings>
      <StopOnIdleEnd>false</StopOnIdleEnd>
      <RestartOnIdle>false</RestartOnIdle>
    </IdleSettings>
    <AllowStartOnDemand>true</AllowStartOnDemand>
    <Enabled>true</Enabled>
    <Hidden>false</Hidden>
    <ExecutionTimeLimit>PT0S</ExecutionTimeLimit>
    <Priority>7</Priority>
    <RestartOnFailure>
      <Interval>PT1M</Interval>
      <Count>999</Count>
    </RestartOnFailure>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>conhost.exe</Command>
      <Arguments>--headless cmd.exe /d /c ""__MISAO__" serve &gt;&gt; "__LOG__" 2&gt;&amp;1"</Arguments>
    </Exec>
  </Actions>
</Task>
